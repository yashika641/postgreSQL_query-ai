# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

# PostgreSQL connection (the query_ai_agent read-only role, not superuser --
# see sql/create_readonly_role.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgresql_query_ai
DB_USER=query_ai_agent
DB_PASSWORD=

# Gemini API key (https://ai.dev) -- free tier is 20 requests/day/model,
# see README for what that means in practice
GEMINI_API_KEY=

# Optional: only needed if you want to override the local Ollama fallback
# endpoint (e.g. running Ollama on a different host/port). Leave unset for
# a normal local install -- sql_generator.py defaults to
# http://localhost:11434/api/generate. docker-compose.yml overrides this
# automatically to host.docker.internal when running in Docker.
# OLLAMA_URL=
